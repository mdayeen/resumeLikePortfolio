# Shared, durable counters and game scores (required for serverless deployments).
MONGODB_URI=
MONGODB_DB=ayeen_portfolio
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORTFOLIO_SESSION_SECRET=
# Optional: use a separate key per environment so preview visits do not affect production.
PORTFOLIO_STORE_KEY=mdayeen:portfolio:v1

# Local/self-hosted alternative: one writable, persistent directory shared by all
# Next.js processes on the same machine. The default is .portfolio-data.
# PORTFOLIO_DATA_DIR=/var/lib/portfolio
